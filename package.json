{
  "name": "fray",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "nub packages/server/src/dev.ts",
    "fray-dev:install": "nub scripts/install-global-cli.mjs",
    "fray-dev:check": "nub scripts/install-global-cli.mjs --check",
    "fray-dev:uninstall": "nub scripts/install-global-cli.mjs --uninstall",
    "install:global": "nub scripts/install-global-cli.mjs",
    "typecheck": "tsc -b packages/shared packages/rpc packages/server packages/cli && nub run --filter @fray-ui/web typecheck",
    "test": "nub --test --test-force-exit 'scripts/**/*.test.mjs' 'packages/shared/src/**/*.test.ts' 'packages/server/src/**/*.test.ts' 'packages/cli/src/**/*.test.ts' 'packages/web/src/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^24",
    "puppeteer": "^25.3.0",
    "typescript": "^5.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "node-pty",
      "@parcel/watcher",
      "esbuild",
      "@fray-ui/server"
    ]
  }
}
