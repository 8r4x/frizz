#!/usr/bin/env node
// @ts-check
/**
 * frizz — the board command, on the worker's Bash PATH while the frizz-worker plugin is enabled.
 * A worker owns ONE thread but can still run `frizz` (validate/read the board for its repo). This
 * shim execs the repo board's bundled script directly (NOT a copy) — cc-worker never forks board logic.
 *
 * Resolving the board: this file is <plugin>/bin/frizz, board/ is a sibling of the plugin root, so the
 * board is at ../../board/index.mjs relative to THIS file — cwd-independent. Imported
 * via a file:// URL so argv/process.env (incl. CLAUDE_PROJECT_DIR) flow straight through.
 */
import { fileURLToPath, pathToFileURL } from 'node:url';
import { dirname, join } from 'node:path';

const here = dirname(fileURLToPath(import.meta.url));
const board = join(here, '..', '..', 'board', 'index.mjs');
await import(pathToFileURL(board).href);
