.claude/settings.local.json
# Claude Code local state + transient agent worktrees (never commit these)
.claude/worktrees/
.claude/jobs/

# ad hoc CDP verification screenshots (scripts/shot.mjs output; see frizz:adhoc-cdp skill)
.adhoc-shots/

