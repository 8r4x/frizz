{
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": false
  },
  "enabledMcpjsonServers": ["chrome-devtools"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/cc-worker/hooks/scratchpad.mjs\" --mode=session-start --via=project" }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/cc-worker/hooks/scratchpad.mjs\" --mode=session-start --via=project" }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/cc-worker/hooks/scratchpad.mjs\" --mode=session-start --via=project" }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/cc-worker/hooks/scratchpad.mjs\" --mode=session-start --via=project" }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/cc-worker/hooks/scratchpad.mjs\" --mode=precompact --via=project" }
        ]
      },
      {
        "matcher": "manual",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/cc-worker/hooks/scratchpad.mjs\" --mode=precompact --via=project" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/cc-worker/hooks/scratchpad.mjs\" --mode=nudge --via=project" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/cc-worker/hooks/scratchpad.mjs\" --mode=nudge --event=PostToolUse --via=project" }
        ]
      }
    ]
  }
}
