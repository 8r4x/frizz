{
  "name": "frayui",
  "version": "0.1.0",
  "private": false,
  "description": "Local orchestration surface for Fray projects — a per-repo web UI over your .fray/ agent threads",
  "keywords": ["fray", "claude", "claude-code", "agents", "orchestration", "tui"],
  "license": "MIT",
  "author": "Colin McDonnell",
  "homepage": "https://github.com/colinhacks/fray",
  "repository": { "type": "git", "url": "git+https://github.com/colinhacks/fray.git", "directory": "packages/cli" },
  "engines": {
    "node": ">=26"
  },
  "type": "module",
  "bin": {
    "frayui": "./dist/frayui.js"
  },
  "files": [
    "dist",
    "web-dist",
    "runtime"
  ],
  "scripts": {
    "prepack": "node ./scripts/prepare-package.mjs && node ./scripts/build-package.mjs && node ./scripts/publish-manifest.mjs --strip",
    "postpack": "node ./scripts/publish-manifest.mjs --restore"
  },
  "dependencies": {
    "@parcel/watcher": "^2.5",
    "better-sqlite3": "^12",
    "node-pty": "^1.1"
  },
  "devDependencies": {
    "@fray-ui/server": "workspace:*",
    "@fray-ui/shared": "workspace:*",
    "esbuild": "^0.25.0"
  }
}
